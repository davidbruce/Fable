<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);FABLE_COMPILER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Global.fs" />
    <Compile Include="List.fs" />
    <Compile Include="Array.fs" />
    <Compile Include="Option.fs" />
    <Compile Include="Result.fs" />
    <Compile Include="Seq.fs" />
    <Compile Include="ResizeArray.fs" />
    <Compile Include="HashSet.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="Queue.fs" />
    <Compile Include="Observable.fs" />
    <Compile Include="Event.fs" />
    <Compile Include="Uri.fs" />
    <Compile Include="Guid.fs" />
    <Compile Include="TimeSpan.fs" />
    <Compile Include="DateTime.fs" />
    <Compile Include="DateOnly.fs" />
    <Compile Include="Async.fs" />
    <Compile Include="Task.fs" />
    <Compile Include="Map.fs" />
    <Compile Include="Set.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fable.Core/Fable.Core.fsproj" />
  </ItemGroup>

</Project>
